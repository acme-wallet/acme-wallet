# ── Node ──
NODE_ENV=development
PORT=3000

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=acme
POSTGRES_PORT=5431

# LLMs

